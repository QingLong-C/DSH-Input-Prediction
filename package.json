{
  "name": "dsh-suggest-ghost",
  "version": "0.5.1",
  "description": "给 DSH 输入框加上输入预测：回合结束后自动建议你的下一句话，Tab 一键采纳；输入时按会话历史做前缀补全。输入预测 / 自动补全。",
  "author": "WuJiaoJue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-collection/dsh-suggest-ghost.git"
  },
  "homepage": "https://github.com/dsh-plugin-collection/dsh-suggest-ghost",
  "bugs": {
    "url": "https://github.com/dsh-plugin-collection/dsh-suggest-ghost/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "screenshots": [
    {
      "src": "./docs/mode-llm-real.png",
      "label": "LLM 下一条建议（草稿为空时自动预测）"
    },
    {
      "src": "./docs/mode-history-real.png",
      "label": "历史前缀补全（输入时按会话历史匹配）"
    },
    {
      "src": "./docs/settings-card.png",
      "label": "设置卡片（section 分组 + 热度管理）"
    }
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node --experimental-strip-types scripts/history-smoke.mjs && node --experimental-strip-types scripts/sanitize-smoke.mjs && node --experimental-strip-types scripts/hotness-persist-smoke.mjs && node --experimental-strip-types scripts/coldstart-smoke.mjs && node scripts/inline-smoke.mjs && node scripts/ghost-geom-smoke.mjs && node scripts/accept-cas-smoke.mjs && node scripts/render-storm-smoke.mjs && node scripts/live-settings-smoke.mjs && node scripts/dev-loop-smoke.mjs && node scripts/ops-envelope-smoke.mjs && node scripts/ops-schema-coverage-smoke.mjs && node scripts/ops-write-verify-smoke.mjs && node --experimental-strip-types scripts/context-summary-smoke.mjs && node --experimental-strip-types scripts/fault-signature-smoke.mjs",
    "test:e2e": "pnpm build && node scripts/hotness-persist-e2e.mjs && node scripts/coldstart-e2e.mjs",
    "preview": "node scripts/preview-card.mjs",
    "replay": "node --experimental-strip-types scripts/replay-history.mjs",
    "check:loop": "node scripts/gitignore-check.mjs && node scripts/artifact-freshness.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
