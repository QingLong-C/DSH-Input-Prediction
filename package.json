{
  "name": "dsh-suggest-ghost",
  "version": "0.5.1-cn.6",
  "description": "回复结束后，在 DSH 输入框里用灰字建议下一句。支持中文追问，Tab 填入草稿，Enter 由你发送。",
  "author": "WuJiaoJue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingLong-C/dsh-input-prediction.git"
  },
  "homepage": "https://github.com/QingLong-C/dsh-input-prediction",
  "bugs": {
    "url": "https://github.com/QingLong-C/dsh-input-prediction/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "SOURCE_BASE.json",
    "LICENSE",
    "locale"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node --experimental-strip-types scripts/history-smoke.mjs && node --experimental-strip-types scripts/sanitize-smoke.mjs && node --experimental-strip-types scripts/hotness-persist-smoke.mjs && node --experimental-strip-types scripts/coldstart-smoke.mjs && node scripts/inline-smoke.mjs && node scripts/ghost-geom-smoke.mjs",
    "test:cn": "node --experimental-strip-types scripts/cn-suggestions-smoke.mjs && node scripts/cn-runtime-smoke.mjs && node scripts/cn-client-smoke.mjs && node scripts/cn-host-smoke.mjs && node scripts/cn-transcript-smoke.mjs && node scripts/cn-live-settings-smoke.mjs && node scripts/cn-intent-smoke.mjs",
    "test:e2e": "pnpm build && node scripts/hotness-persist-e2e.mjs && node scripts/coldstart-e2e.mjs",
    "replay": "node --experimental-strip-types scripts/replay-history.mjs",
    "test:sync": "python3 scripts/test-sync-upstream.py"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "contributors": [
    "QingLong-C"
  ]
}
